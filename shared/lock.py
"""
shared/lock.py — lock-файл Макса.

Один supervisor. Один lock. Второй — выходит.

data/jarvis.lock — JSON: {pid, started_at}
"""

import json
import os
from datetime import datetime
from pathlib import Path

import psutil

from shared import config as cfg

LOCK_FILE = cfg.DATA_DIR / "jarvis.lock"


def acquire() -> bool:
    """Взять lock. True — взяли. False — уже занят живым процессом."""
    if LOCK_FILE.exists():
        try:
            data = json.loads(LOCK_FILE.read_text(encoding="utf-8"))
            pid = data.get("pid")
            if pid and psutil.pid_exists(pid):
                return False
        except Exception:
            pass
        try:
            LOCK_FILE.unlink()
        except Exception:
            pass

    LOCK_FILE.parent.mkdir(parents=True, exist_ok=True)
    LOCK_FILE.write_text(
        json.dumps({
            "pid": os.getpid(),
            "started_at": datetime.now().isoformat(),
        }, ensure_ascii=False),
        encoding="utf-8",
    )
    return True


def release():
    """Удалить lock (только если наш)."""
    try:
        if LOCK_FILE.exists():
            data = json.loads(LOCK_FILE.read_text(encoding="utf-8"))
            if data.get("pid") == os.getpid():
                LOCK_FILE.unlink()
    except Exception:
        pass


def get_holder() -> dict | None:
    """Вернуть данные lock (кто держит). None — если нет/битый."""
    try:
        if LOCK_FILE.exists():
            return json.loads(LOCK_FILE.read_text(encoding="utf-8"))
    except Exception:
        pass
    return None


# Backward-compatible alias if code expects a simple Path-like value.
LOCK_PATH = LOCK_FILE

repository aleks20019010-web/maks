# ------------------------------------------------------------------------
# Небольшая runtime-проверка: не валим весь проект в импорте,
# но даём понятное место, где видно, что обязательный внешний ресурс отсутствует.
# ------------------------------------------------------------------------
def _check_runtime_files() -> None:
    """Проверяет, что критичные файлы для запуска существуют."""
    required = (
        TOKEN_FILE,
        CONFIG_DIR / "llm_key.txt",
        MODELS_DIR,
    )
    for path in required:
        if path is MODELS_DIR:
            continue
        if not path.exists():
            # это предупреждение, а не fatal-ошибка, чтобы проект не падал при импорте
            # а runtime-логика может сгенерировать более понятное сообщение пользователю.
            os.environ.setdefault("MAKS_RUNTIME_WARNING", "1")
            break


_check_runtime_files()


